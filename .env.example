PORT=3000
LOG_LEVEL=info

# OpenAI
OPENAI_API_KEY=sk-<your_openai_api_key>
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_VOICE=alloy

# Twilio
TWILIO_ACCOUNT_SID=AC<your_account_sid>
TWILIO_AUTH_TOKEN=<your_auth_token>

# Call Worker Host (your public-facing host for Twilio to connect back to)
# When using ngrok: CALL_WORKER_HOST=your-tunnel.ngrok.io
# Defaults to localhost:PORT if not set
# CALL_WORKER_HOST=localhost:3000

# Internal API key (shared secret — any random string)
INTERNAL_API_KEY=<your_internal_api_key>

# Database (for postgres backend)
# STORE_BACKEND=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/callapp
