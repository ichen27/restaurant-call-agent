FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/staff-web/package.json apps/staff-web/package-lock.json ./apps/staff-web/
RUN npm ci && npm --prefix apps/staff-web ci
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
COPY apps/staff-web ./apps/staff-web
RUN npm run demo:build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4173
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY --from=build /app/apps/staff-web/dist ./apps/staff-web/dist
USER node
EXPOSE 4173
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD node -e "fetch('http://127.0.0.1:4173/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "dist/demo/server.js"]
